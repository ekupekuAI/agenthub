# AgentHub registry settings. Copy to `.env.local` for local overrides (never commit it), or
# enter the same names in your host's environment settings (Vercel: Project → Settings →
# Environment Variables). Every value below is a placeholder. Nothing here is required for a
# local run: without DATABASE_URL and BLOB_READ_WRITE_TOKEN the registry uses an embedded
# database and a local folder under AGENTHUB_DATA_DIR.

# --- Storage -------------------------------------------------------------------------------

# Hosted Postgres (Neon). Use the *pooled* connection string from the Neon console
# (host contains "-pooler"). Required on Vercel.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Vercel Blob read-write token. Vercel adds it automatically when you connect a Blob store to
# the project. Required on Vercel.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXX_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Access mode the Blob store was created with: private (recommended, default) or public.
# AGENTHUB_BLOB_ACCESS=private

# Where the embedded database, the local package folder and seed tokens live
# (default: apps/web/.data). Not used for storage when the two settings above are set, but the
# seed still writes seed-tokens.txt here.
# AGENTHUB_DATA_DIR=

# --- Administration ------------------------------------------------------------------------

# Enables /admin and the admin API. At least 32 characters; unset disables administration.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AGENTHUB_ADMIN_TOKEN=

# Optional, at least 32 characters: signs admin session cookies. Defaults to a key derived
# from the admin token.
# AGENTHUB_SESSION_SECRET=

# Shown in the footer and on the Guidelines page.
# AGENTHUB_SECURITY_CONTACT=security@example.com

# --- Network -------------------------------------------------------------------------------

# Number of trusted proxies that write X-Forwarded-For. Vercel: set 1. Vercel replaces any
# X-Forwarded-For a client sends with the address it saw (it does not forward client-supplied
# values), so the last entry is the real client and rate limits apply per client. Leave unset
# when the app is reached directly with no proxy in front.
# AGENTHUB_TRUST_PROXY=1

# --- Scanning ------------------------------------------------------------------------------

# Time budget for unpacking and scanning one upload, in ms (default 15000). Keep it well
# below the function time limit (publish routes allow 60 s on Vercel).
# AGENTHUB_SCAN_TIMEOUT_MS=15000

# Uploads scanned at the same time per server instance (default 2).
# AGENTHUB_SCAN_CONCURRENCY=2

# --- Seeding and local development ---------------------------------------------------------

# The seed refuses to write to a hosted database / Blob store (or with NODE_ENV=production)
# unless this is 1. Set it only on the command line for one seed run.
# AGENTHUB_SEED_FORCE=1

# Local development only: route the Neon driver through a plain WebSocket proxy such as Neon's
# local proxy (e.g. localhost:5488/v2). Turns off TLS for that hop; ignored on Vercel.
# AGENTHUB_DB_WS_PROXY=
